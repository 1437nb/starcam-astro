        android:fillColor="#00000000"
        android:pathData="M67,77 L72,77 A5,5 0 0,0 77,72 L77,67"
        android:strokeColor="#BF7FB3E8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />

