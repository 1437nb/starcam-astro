    <path
        android:fillColor="#00000000"
        android:pathData="M31,67 L31,72 A5,5 0 0,0 36,77 L41,77"
        android:strokeColor="#BF7FB3E8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
