    <path
        android:fillColor="#00000000"
        android:pathData="M39.2,46.2 A16.8,16.8 0 0,1 48.5,38.1"
        android:strokeColor="#38FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />

