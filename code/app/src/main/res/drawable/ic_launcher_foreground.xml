    <path
        android:fillColor="#00000000"
        android:pathData="M39.8,60.2 L46.2,52.0 L53.8,57.2 L60.2,45.5 L68.0,49.2"
        android:strokeColor="#9BD4C0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.65" />

    <!-- 星座支线（左上延展） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M46.2,52.0 L43.2,43.0"
        android:strokeColor="#7FB3E8"
        android:strokeLineCap="round"
        android:strokeWidth="1.35" />

    <!-- ==================== 4. 星座节点恒星与主星芒 ==================== -->
