            M68.0,49.2 m-1.55,0 a1.55,1.55 0 1,0 3.1,0 a1.55,1.55 0 1,0 -3.1,0" />

    <!-- 左上小十字星芒（43.2, 43.0） -->
    <path
        android:fillColor="#9BD4C0"
        android:pathData="M43.2,39.2 L44.1,42.1 L47.0,43.0 L44.1,43.9 L43.2,46.8 L42.3,43.9 L39.4,43.0 L42.3,42.1 Z" />
