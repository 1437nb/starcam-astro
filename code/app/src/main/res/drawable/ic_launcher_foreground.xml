    <path
        android:fillColor="#24000000"
        android:pathData="M54,54 m-23.5,0 a23.5,23.5 0 1,0 47,0 a23.5,23.5 0 1,0 -47,0" />

    <!-- 镜片内部深空光学玻璃填充 -->
    <path android:pathData="M54,54 m-21.5,0 a21.5,21.5 0 1,0 43,0 a21.5,21.5 0 1,0 -43,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="47"
                android:centerY="45"
                android:gradientRadius="26"
                android:type="radial">
                <item
                    android:color="#1E3575"
                    android:offset="0.0" />
                <item
                    android:color="#0E1940"
                    android:offset="0.58" />
                <item
                    android:color="#070C22"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 镜头主金属/蓝宝石外圈 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 m-21.5,0 a21.5,21.5 0 1,0 43,0 a21.5,21.5 0 1,0 -43,0"
        android:strokeWidth="2.2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="75.5"
                android:endY="75.5"
                android:startX="32.5"
                android:startY="32.5"
                android:type="linear">
                <item
                    android:color="#A8D0FF"
                    android:offset="0.0" />
                <item
                    android:color="#7FB3E8"
                    android:offset="0.5" />
                <item
                    android:color="#4974A8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 镜头内圈金色光圈刻度环 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 m-18.6,0 a18.6,18.6 0 1,0 37.2,0 a18.6,18.6 0 1,0 -37.2,0"
