        android:fillColor="#D9E3C567"
        android:pathData="M60.2,45.5 L63.7,42.0 L61.1,45.5 L63.7,49.0 L60.2,46.4 L56.7,49.0 L59.3,45.5 L56.7,42.0 Z" />

