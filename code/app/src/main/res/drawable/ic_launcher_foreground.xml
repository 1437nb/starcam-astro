    <!-- 左上取景角 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31,41 L31,36 A5,5 0 0,1 36,31 L41,31"
        android:strokeColor="#BFE3C567"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <!-- 右上取景角 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M67,31 L72,31 A5,5 0 0,1 77,36 L77,41"
        android:strokeColor="#BFE3C567"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
