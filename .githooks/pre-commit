#!/bin/sh
# 提交前凭据自检：防止口令/密钥等被硬编码进源码或文档。
# 启用方式（每台克隆执行一次）：
#     git config core.hooksPath .githooks
# 解释器：优先 python3（Linux 上裸 `python` 常是 Python 2），无 python3 时回退 python（Windows）。
PY=python3
command -v python3 >/dev/null 2>&1 || PY=python
"$PY" tools/check_secrets.py --staged || {
  echo ""
  echo "提交已中止：暂存内容含疑似凭据。"
  echo "确认是误报请加入 .gitleaks.toml 的 allowlist，不要用 --no-verify 绕过。"
  exit 1
}
