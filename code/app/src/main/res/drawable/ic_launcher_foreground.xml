        android:pathData="
            M39.8,60.2 m-1.65,0 a1.65,1.65 0 1,0 3.3,0 a1.65,1.65 0 1,0 -3.3,0
            M46.2,52.0 m-1.85,0 a1.85,1.85 0 1,0 3.7,0 a1.85,1.85 0 1,0 -3.7,0
